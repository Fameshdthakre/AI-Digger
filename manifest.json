{
  "manifest_version": 3,
  "name": "AI Digger",
  "version": "1.0",
  "description": "A flexible, user-customizable web scraper with a visual inspector and anti-bot features.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Scraper"
  }
}
