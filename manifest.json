{
  "manifest_version": 3,
  "name": "AI Digger",
  "version": "1.0.2",
  "description": "A flexible, user-customizable web scraper with a visual inspector and anti-bot features.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Scraper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "css/sidepanel.css",
        "ui/dashboard-page.js",
        "modules/data-store.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
